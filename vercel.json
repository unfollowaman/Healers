{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/device",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/device.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 3 * * *"
    }
  ]
}
