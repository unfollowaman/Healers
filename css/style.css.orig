:root {
  --bg:               #EAEEDE;
  --surface:          #F3F5EA;
  --canvas:           #DCDFCF;
  --ink:              #14160F;
  --ink-soft:         #6B6F5F;
  --ink-faint:        #A9AC98;
  --border-w:         1.6px;
  --border-hair-w:    1px;
  --border-color:     var(--ink);
  --border-hair:      rgba(20, 22, 15, 0.14);
  --surface-raised:   #F7F5F1;
  --text-primary:     #1A1A18;
  --text-secondary:   #7A7A78;
  --text-muted:       #ABABAB;
  --accent:           #CC0000;
  --accent-bright:    #FF0800;
  --accent-glow:      rgba(204, 0, 0, 0.15);
  --knob-light:       #FFFFFF;
  --knob-dark:        #C5C2BA;
  --shadow-out:       6px 6px 14px #C5C2BA, -6px -6px 14px #FFFFFF;
  --shadow-out-sm:    3px 3px 7px #C5C2BA, -3px -3px 7px #FFFFFF;
  --shadow-in:        inset 4px 4px 8px #C5C2BA, inset -4px -4px 8px #FFFFFF;
  --shadow-in-sm:     inset 2px 2px 5px #C5C2BA, inset -2px -2px 5px #FFFFFF;
  --sep-blue-bg:      rgba(100, 140, 230, 0.10);
  --sep-blue-border:  rgba(100, 140, 230, 0.28);
  --waveform-bg:      var(--ink);
  --waveform-bar:     var(--bg);
  --waveform-idle:    var(--ink-faint);
  --radius-sm:        12px;
  --radius-md:        18px;
  --radius-lg:        28px;
  --transition-fast:  0.12s ease;
  --transition-mid:   0.30s ease;
  --transition-slow:  0.50s cubic-bezier(0.4, 0, 0.2, 1);
  --player-height: 132px;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
}

body {
  min-height: 100vh;
  margin: 0;
  padding: 0;
  color: var(--text-primary);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background-color: var(--canvas);
  overflow-x: hidden;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-layout {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 100vh;
}

@media (min-width: 900px) {
  .app-layout {
    flex-direction: row;
    align-items: flex-start;
    max-width: none;
  }
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0; /* Important for flex children to allow text truncation */
}

@media (max-width: 899px) {
  /* On mobile, main-content should not limit height so whole page scrolls, enabling sticky bottom player */
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: var(--bg);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0; /* Prevent blank bar */
  border-bottom: var(--border-w) solid var(--border-color);
}

.header-text {
  display: flex;
  flex-direction: column;
}

.eyebrow {
  color: var(--ink-soft);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.hero-copy {
  margin: 0;
  color: var(--ink);
  font-weight: 600;
  font-size: 16px;
  line-height: 1.2;
}

.header-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.search-container {
  display: flex;
  align-items: center;
  order: 1;
}

.refresh-button {
  order: 2;
}

#search-input {
  width: 0;
  opacity: 0;
  border: var(--border-w) solid var(--border-color);
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 0;
  color: var(--text-primary);
  font-size: 14px;
  outline: none;
  transition: width var(--transition-mid), opacity var(--transition-mid), padding var(--transition-mid);
  pointer-events: none;
}

#search-input.expanded {
  width: 220px;
  opacity: 1;
  padding: 10px 16px;
  pointer-events: auto;
  margin-right: 8px;
}

#search-input::placeholder {
  color: var(--text-muted);
}

.refresh-button,
.icon-button {
  background: #111111; /* Changed to dark per user request */
  border: none;
  cursor: pointer;
  user-select: none;
  box-shadow: var(--shadow-out-sm);
  transition: box-shadow var(--transition-fast);
}

.play-button {
  background: var(--accent); /* Keep play/pause button red */
  border: var(--border-w) solid var(--border-color);
  cursor: pointer;
  user-select: none;
}

.refresh-button:hover,
.icon-button:hover {
  box-shadow: var(--shadow-out);
}

.refresh-button:active,
.icon-button:active {
  box-shadow: var(--shadow-in-sm);
}

#search-toggle,
#refresh-button {
  box-shadow: none;
  border: var(--border-w) solid var(--border-color);
  background: var(--surface);
  border-radius: var(--radius-sm);
  color: var(--ink-soft);
}

#search-toggle:hover,
#refresh-button:hover {
  background: var(--bg);
  box-shadow: none;
}

#search-toggle:active,
#refresh-button:active {
  background: var(--ink);
  color: var(--bg);
  box-shadow: none;
}

/* Ensure images inside buttons cover neatly without distortion and handle brightness if needed */
.icon-button img,
.refresh-button img,
.control-button img,
.song-play-button img,
.play-button img {
  display: block;
  object-fit: contain;
}

.icon-button {
  width: 40px;
  height: 40px;
  border-radius:  50%;
  color: var(--text-secondary);
  display: inline-grid;
  place-items: center;
}

.separator-layer {
  display: none !important;
}

.separator-layer--vertical {
  display: none;
}

@media (min-width: 900px) {
  .separator-layer--vertical {
    display: block;
    width: 1px;
    flex-shrink: 0;
    align-self: stretch;
    background: transparent;
    border: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    pointer-events: none;
    z-index: 50;
  }
}

.library {
  flex: 1;
  /* overflow-y: auto; removed to allow whole page to scroll */
  padding: 0;
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 14px;
  padding: 28px;
  color: var(--text-muted);
  font-size: 14px;
  text-align: center;
}

.status-card[hidden] {
  display: none;
}

/* Skeleton Loading State for Song Rows */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton-row {
  height: 64px;
  margin-bottom: 10px;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-out-sm);
  background: linear-gradient(90deg, var(--surface) 25%, var(--surface-raised) 50%, var(--surface) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* SECTION A - HERO SECTION */
.hero-section {
  display: flex;
  flex-direction: row;
  gap: 20px;
  padding: 20px 20px 0 20px;
  align-items: stretch;
}

.hero-left {
  width: 55%;
}

.hero-cover-art {
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: var(--radius-lg);
  overflow: hidden;

  position: relative;


  background: var(--surface);
  border: var(--border-w) solid var(--border-color);
}



.hero-gradient-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0,0,0,0.75), transparent);
  pointer-events: none;
  z-index: 1;
}

.hero-text-overlay {
  position: absolute;
  bottom: 24px;
  left: 24px;
  z-index: 2;
}

.hero-text-overlay .line1,
.hero-text-overlay .line2 {
  font-size: 22px;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-text-overlay .line3 {
  font-size: 14px;
  font-weight: 400;
  color: rgba(255,255,255,0.65);
  margin-top: 4px;
}

.hero-right {
  width: 45%;
  display: flex;
  flex-direction: column;
  gap: 16px;
  justify-content: space-between;
}

.stats-card {
  padding: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
  background-color: var(--surface);
  border-radius: var(--radius-md);
  border: var(--border-w) solid var(--border-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.stat-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;


  color: var(--ink-soft);
}

.stat-value {
  font-size: 28px;
  font-weight: 700;


  color: var(--ink);
}

.quick-access-card {



  padding: 16px;

  background: var(--surface);
  border-radius: var(--radius-md);
  border: var(--border-w) solid var(--border-color);
}

.quick-access-label {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.quick-access-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.quick-access-btn {



  padding: 10px 14px;
  font-size: 13px;
  font-weight: 500;

  display: flex;
  align-items: center;
  gap: 8px;

  cursor: pointer;
  transition: box-shadow var(--transition-fast), color var(--transition-fast);

  background: var(--bg);
  border-radius: var(--radius-sm);
  border: var(--border-w) solid var(--border-color);
  color: var(--ink-soft);
}

.quick-access-btn:hover {


  background: var(--surface);
}

.quick-access-btn:active {



  background: var(--ink);
  color: var(--bg);
}

.quick-access-btn .icon-button img {
  width: 20px;
  height: 20px;
}

/* SECTION B - RECENTLY ADDED STRIP */
.recently-added-section {
  padding-top: 14px;
}

.section-header-row {
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 16px;
  font-weight: 600;


  color: var(--ink);
}

.section-icon {
  color: var(--text-muted);
  display: flex;
  align-items: center;
}

.recently-added-strip {
  margin-top: 14px;
  padding: 4px 20px 16px 20px;
  display: flex;
  flex-direction: row;
  gap: 14px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.recently-added-strip::-webkit-scrollbar {
  display: none;
}

.thumbnail-card {
  min-width: 130px;
  max-width: 130px;
  scroll-snap-align: start;
  flex-shrink: 0;
  cursor: pointer;
}

.thumbnail-art {
  width: 130px;
  height: 130px;
  border-radius: var(--radius-md);

  overflow: hidden;
  position: relative;

  border: var(--border-w) solid var(--border-color);
  background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
  background-color: var(--surface);
}

.thumbnail-art .hover-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;

  opacity: 0;
  transition: opacity 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%; /* Force it to wrap properly */

  background: rgba(20, 22, 15, 0.1);
}

.thumbnail-art .hover-overlay-icon {
  width: 32px;
  height: 32px;



  display: flex;
  align-items: center;
  justify-content: center;


}

.thumbnail-art .hover-overlay-icon img {
  display: block;
}

.thumbnail-card:hover .hover-overlay {
  opacity: 1;
}

.thumbnail-title {
  margin-top: 10px;
  font-size: 13px;
  font-weight: 500;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 130px;

  color: var(--ink);
}

.thumbnail-artist {
  font-size: 12px;
  font-weight: 400;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;

  color: var(--ink-soft);
}


/* SECTION C - ALL SONGS LIST */
.all-songs-section .section-header-row {
  justify-content: flex-start;
  gap: 10px;
  margin-top: 14px;
}

.count-badge {
  background: var(--surface);
  box-shadow: var(--shadow-in-sm);
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
}

.column-headers {
  margin-top: 14px;
  padding: 8px 20px;
  display: grid;
  grid-template-columns: 32px 1fr 1fr 60px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.col-index { text-align: center; }
.col-time { text-align: right; }

.song-list {
  display: flex;
  flex-direction: column;
}

.song-row {
  display: grid;
  grid-template-columns: 32px 1fr 1fr 60px;
  align-items: center;
  padding: 12px 16px;
  margin: 0 16px 0 16px;
  background: transparent;
  border-bottom: var(--border-hair-w) solid var(--border-hair);
  cursor: pointer;
  transition: background var(--transition-fast);
  user-select: none;
}

.song-row:last-child {
  border-bottom: none;
}

.song-index {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.song-row:hover {
  background: var(--surface);
}

.song-row:active {
  background: var(--bg);
}

.song-row.active {
  background: var(--surface);
  border-left: 3px solid var(--ink);
  border-bottom: var(--border-hair-w) solid var(--border-hair);
  padding-left: 13px; /* Compensate for border */
}

.song-details {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.song-title {
  display: block;
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-artist-sub {
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: none; /* Hidden on desktop, shows standalone artist instead */
}

.song-artist-col {
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-duration {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.track-meta span {
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 400;
}

.track-meta strong {
  color: var(--text-primary);
  font-size: 18px;
  font-weight: 600;
}

.progress-wrap span {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.icon-button,
.play-button {
  display: inline-grid;
  place-items: center;
  border-radius: 999px;
}

.song-play-button {
  width: 20px;
  height: 20px;
  color: var(--ink);
  background: transparent;
  border: none;
  display: none;
  place-items: center;
  position: absolute;
  right: 16px;
}

.song-row:hover {
  position: relative;
}

.song-row:hover .song-play-button {
  display: inline-grid;
}

.song-row:hover .song-duration {
  opacity: 0; /* Hide duration when play button shows up */
}

.song-play-button:active {
  color: var(--ink-soft);
}

.song-row.active .song-play-button {
  display: none; /* Hide play button on active row to show playing state simply */
}

.sidebar-player {
  order: 1; /* After main content on mobile */
  position: sticky;
  z-index: 200;
  background: var(--bg);
  width: 100%;
  transition: all var(--transition-slow);

  /* Mobile Idle State (default) */
  bottom: 0;
  top: auto;
  padding: 14px 20px;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.sidebar-player.player--playing {
  /* Playing state dynamically sets top in JS based on header height, but needs these */
  top: 0; /* Fallback */
  bottom: auto;
  padding: 0 0 16px 0;
  flex-direction: column;
  align-items: stretch;
}

/* Desktop Sidebar Player Styles */
@media (min-width: 900px) {
  .sidebar-player {
    order: -1; /* First */
    width: 360px;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    bottom: auto;
    align-self: flex-start;
    background: var(--surface-raised);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: var(--shadow-out);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    height: auto; /* Allow content to dictate height */
    transition: none; /* remove slide transition on desktop */
  }

  .sidebar-player.player--playing {
    top: 0 !important; /* Override inline styles from JS */
    padding: 24px;
  }
}

.desktop-art-container {
  display: none;
}

@media (min-width: 900px) {
  .desktop-art-container {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-out);
    position: relative;
  }
}

.desktop-art-placeholder {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at 30% 40%, #2C1810 0%, #1A0A00 30%, #0D0D0D 60%, #1A1A2E 100%);
  transition: opacity var(--transition-slow);
}

.desktop-art-placeholder::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(45deg, transparent, transparent 2px, rgba(255,255,255,0.015) 2px, rgba(255,255,255,0.015) 4px);
  pointer-events: none;
}

.desktop-art-text-overlay {
  position: absolute;
  bottom: 24px;
  left: 24px;
  z-index: 2;
  background: linear-gradient(to top, rgba(0,0,0,0.75), transparent);
  padding: 10px;
  border-radius: var(--radius-md);
  /* Use similar text treatment as hero */
}
.desktop-art-text-overlay .line1 { font-size: 18px; font-weight: 700; color: #FFFFFF; }
.desktop-art-text-overlay .line2 { font-size: 14px; font-weight: 400; color: rgba(255,255,255,0.65); margin-top: 4px; }


#waveform-canvas-desktop {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0; left: 0;
  opacity: 0;
  transition: opacity var(--transition-slow);
  background: var(--waveform-bg);
}

.player--playing #waveform-canvas-desktop {
  opacity: 1;
}
.player--playing .desktop-art-placeholder {
  opacity: 0;
}

#waveform-canvas-mobile {
  width: 100%;
  height: 0;
  opacity: 0;
  transition: height var(--transition-slow), opacity var(--transition-slow);
  background: var(--waveform-bg);
  display: block;
}

@media (min-width: 900px) {
  #waveform-canvas-mobile {
    display: none;
  }
}

.player--playing #waveform-canvas-mobile {
  height: 110px;
  opacity: 1;
}

.player-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

@media (min-width: 900px) {
  .player-info {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
}

.player--playing .player-info {
  padding: 14px 20px 0 20px;
}

@media (min-width: 900px) {
  .player--playing .player-info {
    padding: 0;
  }
}

.album-art-placeholder {
  width: 48px;
  height: 48px;
  background: var(--surface-raised);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-out-sm);
}

.player--playing .album-art-placeholder {
  display: none;
}

@media (min-width: 900px) {
  .album-art-placeholder {
    display: none;
  }
}

.flex-spacer {
  flex: 1;
}

@media (min-width: 900px) {
  .flex-spacer {
    display: none;
  }
}

.track-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 2px;
}

.progress-container {
  /* Minimal in IDLE state on mobile */
  position: absolute;
  top: -3px;
  left: 0;
  width: 100%;
  padding: 0;
  display: flex;
  flex-direction: column;
}

@media (min-width: 900px) {
  .progress-container {
    position: static;
    padding: 0;
    margin-top: 10px;
  }
}

.player--playing .progress-container {
  position: static;
  padding: 10px 20px;
}

@media (min-width: 900px) {
  .player--playing .progress-container {
    padding: 0;
  }
}

.progress-track {
  width: 100%;
  height: 3px;
  -webkit-appearance: none;
  background: var(--surface);
  border: var(--border-w) solid var(--border-color);
  border-radius: 999px;
  outline: none;
  margin-bottom: 0px;
}

@media (min-width: 900px) {
  .progress-track {
    height: 6px;
    margin-bottom: 6px;
  }
}

.player--playing .progress-track {
  height: 6px;
  margin-bottom: 6px;
}

.progress-track::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border: var(--border-w) solid var(--border-color);
  border-radius: 50%;
  background: var(--surface-raised);
  cursor: pointer;
}


.time-labels {
  display: none;
  justify-content: space-between;
}

@media (min-width: 900px) {
  .time-labels {
    display: flex;
  }
}

.player--playing .time-labels {
  display: flex;
}

.time-labels span {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-left: auto; /* Push to right in IDLE on mobile */
}

@media (min-width: 900px) {
  .player-controls {
    margin-left: 0;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap; /* Allow knob to wrap below */
  }
}

.player--playing .player-controls {
  padding: 12px 20px 0 20px;
  justify-content: center;
  margin-left: 0;
  gap: 14px; /* Reduced gap for playing row per spec */
}

@media (min-width: 900px) {
  .player--playing .player-controls {
    padding: 0;
    gap: 16px;
  }
}

/* New Shuffle and Repeat Buttons */
.control-button {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  background: #111111; /* Changed to dark per user request */
  border: var(--border-w) solid var(--border-color);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  position: relative;
}



.control-button.is-active, .control-button[aria-pressed="true"], .control-button[aria-label^="Repeat "]:not([aria-label="Repeat off"]) {
  background: var(--ink);
  color: var(--bg);
  border-color: var(--ink);
}

.repeat-one-badge {
  position: absolute;
  bottom: 6px;
  right: 6px;
  font-size: 9px;
  font-weight: 700;
  color: var(--accent);
  background: var(--bg); /* To cover parts of the icon if needed, though mostly text overlays */
  border-radius: 50%;
  line-height: 1;
  padding: 1px;
}

/* Hide extra buttons on mobile idle */
.shuffle-button, .repeat-button {
  display: none;
}

@media (min-width: 900px) {
  .shuffle-button, .repeat-button {
    display: flex;
  }
}

.player--playing .shuffle-button, .player--playing .repeat-button {
  display: flex;
}

.prev-button, .next-button {
  width: 44px;
  height: 44px;
}

.play-button {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--accent);
  color: #FFFFFF;
  border: var(--border-w) solid var(--border-color);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}



.volume-container {
  display: none; /* Hidden on mobile idle */
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 90%;
  margin: 16px auto 0 auto;
}

@media (min-width: 900px) {
  .volume-container {
    display: flex;
    width: 100%;
    margin-top: 10px;
  }
}

.player--playing .volume-container {
  display: flex;
}

.volume-container .progress-track {
  margin-bottom: 0;
  flex: 1;
}

.volume-btn {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
}

.volume-icon {
  width: 20px;
  height: 20px;
  color: var(--text-secondary);
}


/* SECTION E - MOBILE RESPONSIVE RULES */
@media (max-width: 640px) {
  .hero-section {
    flex-direction: column;
  }

  .hero-left, .hero-right {
    width: 100%;
  }

  .stats-card .stat-value {
    font-size: 22px;

  color: var(--ink);
}

  .hero-text-overlay .line1,
  .hero-text-overlay .line2 {
    font-size: 18px;
  }

  .thumbnail-card {
    min-width: 110px;
    max-width: 110px;
  }

  .thumbnail-art {
    width: 110px;
    height: 110px;

  border: var(--border-w) solid var(--border-color);
  background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
  background-color: var(--surface);
}
}

@media (max-width: 480px) {
  .column-headers {
    grid-template-columns: 24px 1fr 52px;
  }

  .col-artist {
    display: none;
  }

  .song-row {
    grid-template-columns: 24px 1fr 52px;
  }

  .song-artist-col {
    display: none;
  }

  .song-artist-sub {
    display: block; /* Show artist under title on mobile */
  }

  .song-row:hover .song-duration {
      opacity: 1;
  }

  .song-play-button {
      right: auto;
      left: 12px;
      width: 20px;
      height: 20px;
  }
  .song-row:hover .song-index {
      opacity: 0;
  }
  .song-row:hover .song-play-button {
      display: inline-grid;
  }
}

@media (hover: none) {
  .refresh-button:hover,
  .icon-button:hover,
  .play-button:hover,
  .quick-access-btn:hover {



  background: var(--surface);
}

  .song-row:hover .song-play-button {
    display: none;
  }
  .song-row:hover .song-duration {
      opacity: 1;
  }
  .song-row:hover .song-index {
      opacity: 1;
  }
}

/* SECTION - MOBILE TAB BAR */
#mobile-tab-bar {
  display: none;
}

@media (max-width: 768px) {
  #sidebar {
    display: none !important;
  }

  #mobile-tab-bar {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 300;
    height: 64px;
    background: var(--bg);
    padding: 0 8px;
    padding-bottom: env(safe-area-inset-bottom);
    border-top: var(--border-w) solid var(--border-color);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    justify-content: space-around;
    align-items: stretch;
  }

  .tab-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 8px 16px;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
    background: var(--bg);
    transition: background-color var(--transition-fast);
    border-top: 2px solid transparent;
  }

  .tab-btn:active {
    background-color: var(--surface);
  }

  .tab-btn.tab-active {
    border-top: 2px solid var(--ink);
    border-radius: 0;
  }

  .tab-icon {
    width: 20px;
    height: 20px;
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tab-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tab-btn span {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .tab-btn.tab-active .tab-icon {
    color: var(--ink);
  }

  .tab-btn.tab-active span {
    color: var(--ink);
  }
}

/* SECTION - MOBILE NOW PLAYING FULLSCREEN */
#mobile-nowplaying-fullscreen {
  display: contents; /* Desktop uses contents so it doesn't break layout */
}

.nowplaying-drag-handle {
  display: none;
}

.mobile-queue-peek {
  display: none;
}

.mobile-safe-area-spacer {
  display: none;
}

@media (max-width: 768px) {
  #mobile-nowplaying-fullscreen {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 500;
    background: var(--bg);
    transform: translateY(100%);
    transition: transform var(--transition-slow);
    overflow-y: auto;
    overflow-x: hidden;
  }

  #mobile-nowplaying-fullscreen.is-open {
    transform: translateY(0);
  }

  .nowplaying-drag-handle {
    display: block;
    width: 40px;
    height: 12px;
    background: var(--bg);
    border: var(--border-w) solid var(--border-color);
    border-radius: 999px;
    margin: 12px auto 8px auto;
    flex-shrink: 0;
  }

  .mobile-queue-peek {
    display: block;
    padding: 12px 20px 0 20px;
  }

  .queue-peek-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .mobile-queue-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--surface);
    cursor: pointer;
  }

  .mobile-queue-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }

  .mobile-queue-artist {
    font-size: 12px;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mobile-queue-duration {
    font-size: 12px;
    color: var(--text-muted);
    margin-left: auto;
  }

  .mobile-safe-area-spacer {
    display: block;
    height: env(safe-area-inset-bottom);
    flex-shrink: 0;
    margin-top: auto;
  }

  /* When fullscreen, change the player layout elements */
  #mobile-nowplaying-fullscreen .player-info {
    padding: 16px 20px 0 20px;
  }

  #mobile-nowplaying-fullscreen .progress-container {
    padding: 12px 20px;
  }

  #mobile-nowplaying-fullscreen .player-controls {
    padding: 12px 20px;
  }

  #mobile-nowplaying-fullscreen .volume-container {
    padding: 8px 20px;
    margin-top: 0;
  }

  #waveform-canvas-mobile {
    height: 180px !important; /* Force height inside fullscreen */
    padding: 0;
  }

  /* On mobile player idle we used to hide stuff, but now they are only hidden on the mini player, the fullscreen has them */
  .shuffle-button, .repeat-button, .volume-container {
    display: flex; /* Override idle display none */
  }

  .sidebar-player.player {
    /* override previous mobile idle styles since player is now just the fullscreen wrapper container basically */
    padding: 0;
    background: transparent;
    position: static;
  }

  /* Hide the desktop art inside mobile fullscreen just in case */
  .desktop-art-container {
    display: none !important;
  }
}

/* SECTION - MINI NOW-PLAYING BAR */
#mobile-mini-player {
  display: none;
}

@media (max-width: 768px) {
  #mobile-mini-player {
    position: fixed;
    bottom: 64px; /* Above tab bar */
    left: 0;
    right: 0;
    z-index: 299;
    height: 64px;
    background: var(--bg);
    border-top: var(--border-w) solid var(--border-color);
    display: none; /* hidden by default */
    align-items: center;
    padding: 0 16px;
    gap: 12px;
    cursor: pointer;
    /* Extra padding bottom for safe area if we need it, but since it's above tab bar, tab bar handles safe area. Actually, we should offset it by safe area inset bottom. */
    bottom: calc(64px + env(safe-area-inset-bottom));
  }

  .mini-waveform {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 16px;
  }

  .mini-bar {
    width: 3px;
    border-radius: 999px;
    background: var(--accent);
    height: 4px;
  }

  /* Waveform animation */
  @keyframes bounceWave {
    0%, 100% { height: 4px; }
    50% { height: 16px; }
  }

  #mobile-mini-player.is-playing .mini-bar-1 { animation: bounceWave 0.8s ease-in-out infinite; }
  #mobile-mini-player.is-playing .mini-bar-2 { animation: bounceWave 0.8s ease-in-out infinite 0.2s; }
  #mobile-mini-player.is-playing .mini-bar-3 { animation: bounceWave 0.8s ease-in-out infinite 0.4s; }

  .mini-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0; /* for truncation */
  }

  .mini-info strong {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mini-info span {
    font-size: 12px;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #mini-play-button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #mini-play-button:active {
    background: var(--ink-soft);
  }
}

/* SECTION - MOBILE CONTENT VIEWS */
.placeholder-text {
  text-align: center;
  color: var(--text-muted);
  font-size: 14px;
  padding: 40px 20px;
}

.more-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px;
}

.more-item-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--surface-raised);
  box-shadow: var(--shadow-out-sm);
  border-radius: var(--radius-md);
  padding: 14px 16px;
  border: none;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  transition: box-shadow var(--transition-fast);
}

.more-item-btn:active {
  box-shadow: var(--shadow-in-sm);
}

.more-item-btn .tab-icon {
  width: 24px;
  height: 24px;
  color: var(--text-secondary);
}

.more-item-btn .tab-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(1px 0 0 #111111) drop-shadow(-1px 0 0 #111111) drop-shadow(0 1px 0 #111111) drop-shadow(0 -1px 0 #111111);
}

@media (max-width: 768px) {
  /* On mobile, views handle their own scrolling and visibility */
  .mobile-views-container {
    display: block;
    width: 100%;
  }

  .mobile-view {
    display: none;
    width: 100%;
    /* Add padding for tab bar and mini player (64 + 64 + 8) + safe area */
    padding-bottom: calc(136px + env(safe-area-inset-bottom));
  }

  .mobile-view.active-view {
    display: block;
  }

  /* Hide original hero right since we copied it into mobile home view?
     Wait, it's better to just move elements, or hide the desktop ones.
     Actually, let's keep the desktop ones where they are and hide them on mobile.
  */
  .hero-section {
    display: none;
  }
}

/* Header Adjustment on Mobile */
@media (max-width: 768px) {
  /* Add padding-bottom to the main scroll container equal to mini bar + tab bar + safe area */
  /* Wait, we added it to .mobile-view directly, which is better since it affects the actual scrolling container */
}

/* On desktop, restore normal layout and ignore mobile wrappers */
@media (min-width: 769px) {
  .mobile-views-container {
    display: contents;
  }
  .mobile-view {
    display: contents;
  }

  /* The mobile specific stats card and new elements shouldn't show on desktop */
  #mobile-view-home .hero-right {
    display: none;
  }

  #mobile-view-artists .placeholder-text,
  #mobile-view-library .placeholder-text,
  #mobile-view-more .more-list {
    display: none;
  }
}

/* SECTION F - DASHBOARD LAYOUT (>= 900px) */
@media (min-width: 900px) {
  .dashboard-grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
    display: grid;
    grid-template-columns: 240px 1fr;
    column-gap: 20px;
    row-gap: 20px;
    grid-template-areas:
      "sidebar mainTop"
      "sidebar mainRecent"
      "sidebar mainSongs";
    width: 100%;
    align-items: start;
    background: var(--bg);
    border: var(--border-w) solid var(--border-color);
  }

  .sidebar {
    grid-area: sidebar;
    position: sticky;
    /* top offset will be set by JS based on header height, default fallback */
    top: 70px;
    height: calc(100vh - 70px - 20px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 0;
    overflow: hidden;
    background: var(--surface);
    border-radius: var(--radius-md);
    border: var(--border-w) solid var(--border-color);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-radius: 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    border-bottom: var(--border-w) solid var(--border-color);
  }

  .nav-item:last-child {
    border-bottom: none;
  }

  .nav-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-icon svg {
    color: inherit;
  }

  .nav-item:hover {
    background: var(--surface-raised);
    border-radius: 0;
  }

  .nav-item.active {
    background: var(--surface-raised);
    border-left: 3px solid var(--ink);
    border-radius: 0;
    color: var(--ink);
    padding-left: 17px; /* Compensate for 3px left border to keep text aligned */
  }

  .queue-divider {
    border-top: 1px solid rgba(197, 194, 186, 0.3); /* --knob-dark at 30% */
    margin: 8px 0;
  }

  .queue-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 4px;
    padding: 0 20px;
  }

  .playing-queue {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-right: 4px; /* for scrollbar */
  }

  .queue-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    border-radius: 0;
    cursor: pointer;
    background: transparent;
    border-bottom: var(--border-w) solid var(--border-color);
  }

  .queue-row:hover {
    background: var(--surface-raised);
  }

  .queue-row.active {
    background: var(--surface-raised);
    border-left: 3px solid var(--ink);
    padding-left: 17px;
    border-radius: 0;
    border-bottom: var(--border-w) solid var(--border-color);
  }

  .queue-row.active .queue-title {
    color: var(--ink);
    font-weight: 600;
  }

  .queue-row:last-child {
    border-bottom: none;
  }

  .queue-thumbnail {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;

  border: var(--border-w) solid var(--border-color);
  background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
  background-color: var(--surface);
}

  .queue-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .queue-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .queue-artist {
    font-size: 11px;
    font-weight: 400;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .content-wrapper {
    display: contents; /* Let children join the grid */
  }

  .mainTop-container {
    grid-area: mainTop;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 20px;
    align-items: stretch;
  }

  .recently-added-section {
    grid-area: mainRecent;
    width: 100%;
  }

  .all-songs-section {
    grid-area: mainSongs;
    width: 100%;
  }

  .sep-desktop-hide {
    display: none !important;
  }

  /* Redefine Player for Desktop Grid */
  .sidebar-player.player {
    position: static !important;
    width: 100%;
    order: unset;
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-out);
    padding: 20px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
    height: auto !important;
    top: auto !important;
  }

  .desktop-art-container {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-out-sm);
    position: relative;
    overflow: hidden;
  }

  #waveform-canvas-desktop {
    position: relative; /* Not absolute overlay */
    width: 100%;
    height: 80px;
    border-radius: var(--radius-md);
    background: var(--waveform-bg);
    opacity: 1; /* Always visible */
    margin-top: 0;
  }

  /* Move waveform below art instead of overlay */
  .desktop-art-container {
    display: block;
    margin-bottom: 0px;
  }

  .sidebar-player.player .desktop-art-placeholder {
     opacity: 1; /* Always visible, unless real art */
  }

  .player-info {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 2px !important;
    padding: 0 !important;
  }

  .player-info .track-meta strong {
    font-size: 18px;
    font-weight: 600;
  }

  .player-info .track-meta span {
    font-size: 14px;
  }

  .progress-container {
    position: static !important;
    padding: 0 !important;
    margin-top: 0px !important;
  }

  .player-controls {
    justify-content: center !important;
    gap: 20px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Force display components in desktop player */
  .shuffle-button, .repeat-button, .volume-container {
    display: flex !important;
  }

  /* Hero Section updates for desktop */
  .hero-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0;
  }

  .hero-left {
    display: none; /* Removed from this layout at >= 900px */
  }

  .hero-right {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
}

/* Fixes for Desktop Player Waveform Layout */
@media (min-width: 900px) {
  #waveform-canvas-desktop {
    position: static;
    display: block;
    width: 100%;
    height: 80px;
  }
}

/* Display fav button on hover */
.song-row:hover .fav-button {
  display: flex !important;
}
.song-row.active .fav-button {
  display: flex !important;
}

/* For mobile, keep it simpler */
@media (max-width: 480px) {
  .song-row .fav-button {
    right: 40px !important;
  }
}

.song-row:hover .add-playlist-btn,
.song-row:hover .remove-playlist-btn {
  display: flex !important;
}
.song-row.active .add-playlist-btn,
.song-row.active .remove-playlist-btn {
  display: flex !important;
}
.playlist-card:hover .delete-playlist-btn {
  display: flex !important;
}

@media (max-width: 480px) {
  .song-row .add-playlist-btn,
  .song-row .remove-playlist-btn {
    right: 70px !important;
  }
}

.playlist-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  background: var(--surface-raised);
  box-shadow: var(--shadow-out);
  border-radius: var(--radius-md);
  padding: 8px;
  z-index: 100;
  min-width: 150px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.playlist-dropdown-item {
  padding: 8px 12px;
  font-size: 13px;
  color: var(--text-primary);
  border-radius: var(--radius-sm);
  cursor: pointer;
}
.playlist-dropdown-item:hover {
  background: var(--surface);
  box-shadow: var(--shadow-in-sm);
}

/* Mobile-only homepage redesign */
@media (max-width: 768px) {
  .header {
    padding: 18px 32px 20px;
    border-bottom: var(--border-w) solid var(--border-color);
  }

  .mobile-view.active-view {
    padding: 26px 28px calc(136px + env(safe-area-inset-bottom));
  }

  #mobile-view-home {
    background: var(--bg);
  }

  #mobile-view-home > .hero-right,
  .mobile-hero-card,
  .mobile-quick-access,
  .mobile-artists-preview,
  .mobile-queue-preview {
    width: 100%;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .mobile-hero-card {
    min-height: 290px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 42%;
    align-items: center;
    gap: 16px;
    padding: 30px 28px;
    border-radius: 22px;


    overflow: hidden;
    position: relative;

  background: var(--surface);
  border: var(--border-w) solid var(--border-color);
}

  .mobile-hero-kicker {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 15px;
    font-weight: 700;
  }

  .mobile-hero-card h1 {
    margin: 0;
    max-width: 260px;
    color: var(--text-primary);
    font-size: clamp(29px, 8vw, 42px);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .mobile-hero-card p:not(.mobile-hero-kicker) {
    max-width: 245px;
    margin: 22px 0 0;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.38;
  }

  .mobile-shuffle-all {
    margin-top: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;


    padding: 14px 18px;


    font-size: 15px;
    font-weight: 700;


  background: var(--bg);
  border: var(--border-w) solid var(--border-color);
  border-radius: 999px;
  color: var(--ink);
}

  .mobile-hero-art {
    min-height: 220px;
    position: relative;
  }

  .hero-album-tile {
    position: absolute;
    right: 10px;
    top: 58px;
    width: 128px;
    height: 128px;
    display: grid;
    place-items: center;
    border-radius: 34px;
    background: linear-gradient(145deg, #fff, #f2eeee);
    color: #ff4d55;
    font-size: 72px;
    font-weight: 800;
    transform: rotate(9deg);
    box-shadow: 12px 16px 26px rgba(204, 0, 0, 0.13), -8px -8px 18px rgba(255, 255, 255, 0.9);
  }

  .music-note {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #f9e5e5;
    color: #ff555d;
    font-size: 25px;
    font-weight: 800;
    box-shadow: var(--shadow-out-sm);
  }

  .note-one { left: 4px; top: 82px; }
  .note-two { right: 0; top: 36px; }

  #mobile-view-home > .hero-right {
    display: block;
    margin-top: 24px;
  }

  #mobile-view-home .stats-card {
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 18px 10px;
  }

  #mobile-view-home .stat-item {
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 0;
    padding: 0 8px;
    border-right: var(--border-w) solid var(--border-color);
  }

  #mobile-view-home .stat-item:last-child { border-right: 0; }

  #mobile-view-home .stat-value {
    order: -1;
    font-size: clamp(20px, 6vw, 29px);
    line-height: 1;
    white-space: nowrap;

  color: var(--ink);
}

  #mobile-view-home .stat-label {
    font-size: 10px;
    letter-spacing: 0.04em;

  color: var(--ink-soft);
}

  .mobile-quick-access,
  .recently-added-section,
  .mobile-artists-preview,
  .mobile-queue-preview {
    margin-top: 34px;
  }

  .mobile-quick-access h2 {
    margin: 0 0 16px;
    font-size: 18px;
    line-height: 1;
  }

  .mobile-quick-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  #mobile-view-home .quick-access-btn {
    min-height: 72px;
    padding: 10px 12px;
    justify-content: flex-start;





  border-radius: var(--radius-sm);
  border: var(--border-w) solid var(--border-color);


}

  #mobile-view-home .quick-access-btn .icon-button {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
  }

  .recently-added-section .section-header-row,
  .mobile-artists-preview .section-header-row,
  .mobile-queue-preview .section-header-row {
    padding: 0;
  }

  .section-link {
    border: 0;
    background: transparent;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    padding: 0;
  }

  .recently-added-strip {
    padding: 4px 0 8px;
    gap: 22px;
  }

  .thumbnail-card { min-width: calc((100vw - 100px) / 3); max-width: calc((100vw - 100px) / 3); }
  .thumbnail-art { width: 100%; height: auto; aspect-ratio: 1;
  border: var(--border-w) solid var(--border-color);
  background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
  background-color: var(--surface);
}

  .mobile-artist-list,
  .mobile-queue-card {
    margin-top: 16px;
    border-radius: 14px;
    background: rgba(247, 245, 241, 0.78);
    border: 1px solid rgba(197, 194, 186, 0.38);
    box-shadow: var(--shadow-out-sm);
    overflow: hidden;
  }

  .mobile-artist-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    border: 0;
    border-bottom: 1px solid rgba(197, 194, 186, 0.34);
    background: transparent;
    padding: 14px 18px;
    text-align: left;
  }

  .mobile-artist-row:last-child { border-bottom: 0; }

  .artist-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: 0 0 48px;
    background: linear-gradient(135deg, #173044, #2851a3);
    color: #fff;
    font-weight: 700;
  }

  .artist-row-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .artist-row-copy strong,
  .queue-preview-copy strong { color: var(--text-primary); font-size: 16px; }
  .artist-row-copy span,
  .queue-preview-copy span { color: var(--text-secondary); font-size: 14px; }
  .artist-chevron { color: var(--text-secondary); font-size: 30px; line-height: 1; }

  .mobile-queue-card {
    min-height: 82px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
  }

  .queue-preview-art {
    width: 56px;
    height: 56px;
    flex: 0 0 56px;
    border-radius: 10px;
  }

  .queue-preview-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .queue-preview-copy strong,
  .queue-preview-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .queue-overflow {
    border: 0;
    background: transparent;
    color: var(--text-secondary);
    font-size: 26px;
    padding: 6px;
  }

  .mobile-empty-row {
    width: 100%;
    padding: 18px;
    color: var(--text-secondary);
    font-size: 14px;
  }
}

@media (max-width: 430px) {
  .header { padding-left: 20px; padding-right: 20px; }
  .mobile-view.active-view { padding-left: 16px; padding-right: 16px; }
  .mobile-hero-card { grid-template-columns: 1fr 36%; padding: 26px 20px;
  background: var(--surface);
  border: var(--border-w) solid var(--border-color);
}
  .hero-album-tile { width: 94px; height: 94px; border-radius: 26px; font-size: 54px; }
  .music-note { width: 38px; height: 38px; font-size: 20px; }
  .mobile-quick-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .thumbnail-card { min-width: 128px; max-width: 128px; }
}

@media (min-width: 769px) {
  .section-link,
  .mobile-hero-card,
  .mobile-quick-access,
  .mobile-artists-preview,
  .mobile-queue-preview {
    display: none !important;
  }
}

@media (max-width: 768px) {
  .desktop-recent-icon {
    display: none !important;
  }
}

/* Desktop dashboard homepage redesign */
@media (min-width: 900px) {
  .header {
    padding: 10px 32px;
    gap: 32px;
  }

  .header-controls {
    justify-content: flex-end;
    gap: 18px;
  }

  .hero-copy {
    font-size: 14px;
    line-height: 20px;
  }

  .refresh-button {
    order: unset;
  }

  .search-container {
    order: unset;
    justify-content: flex-end;
  }

  #search-input {
    width: 0;
    height: 58px;
    opacity: 0;
    pointer-events: none;
    padding: 0;
    margin: 0;
    border: var(--border-w) solid transparent;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    font-size: 18px;
    font-weight: 500;
    box-shadow: none;
    transform-origin: right center;
    transition: width var(--transition-mid), opacity var(--transition-mid), padding var(--transition-mid), margin var(--transition-mid), border-color var(--transition-mid);
  }

  .search-container:hover #search-input,
  .search-container:focus-within #search-input,
  #search-input.expanded {
    width: 200px;
    opacity: 1;
    pointer-events: auto;
    padding: 0 20px;
    margin-right: 18px;
    border-color: var(--border-color);
  }

  .search-icon-btn,
  #refresh-button {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    border: var(--border-w) solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    box-shadow: none;
  }

  .search-icon-btn svg,
  #refresh-button svg {
    width: 28px;
    height: 28px;
    stroke-width: 1.6;
  }

  .dashboard-grid {
    max-width: 1680px;
    padding: 24px 28px;
    grid-template-columns: 250px minmax(0, 1fr);
    column-gap: 28px;
    row-gap: 28px;
    background: var(--bg);
  }

  .mainTop-container {
    grid-template-columns: minmax(0, 1fr);
  }

  .sidebar-player.player:not(.player--playing) {
    display: none !important;
  }

  .sidebar-player.player.player--playing {
    position: fixed !important;
    right: 28px;
    bottom: 28px;
    z-index: 250;
    width: 340px;
  }

  .hero-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 420px;
    gap: 28px;
    align-items: stretch;
    padding: 0;
  }

  .hero-left {
    display: block;
    width: 100%;
  }

  .hero-cover-art {
    min-height: 382px;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 20px;



  background: var(--surface);
  border: var(--border-w) solid var(--border-color);
}

  .hero-cover-art::after,
  .hero-gradient-overlay,
  .hero-text-overlay { display: none; }

  .hero-copy-panel {
    position: relative;
    z-index: 2;
    padding: 54px 56px;
  }

  .hero-kicker {
    margin: 0 0 24px;
    color: var(--accent);
    font-weight: 700;
  }

  .hero-copy-panel h1 {
    margin: 0;
    font-size: clamp(36px, 3vw, 48px);
    line-height: 1.06;
    letter-spacing: -0.055em;
  }

  .hero-subtitle {
    margin: 26px 0 0;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.55;
  }

  .desktop-shuffle-all {
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    gap: 12px;


    padding: 15px 22px;


    font-weight: 700;


  background: var(--bg);
  border: var(--border-w) solid var(--border-color);
  border-radius: 999px;
  color: var(--ink);
}

  .hero-art-scene {
    position: absolute;
    inset: 0;
  }

  .hero-album-tile {
    right: 13%;
    top: 92px;
    width: 150px;
    height: 150px;
  }

  .note-one { left: auto; right: 29%; top: 142px; }
  .note-two { right: 9%; top: 84px; }

  .hero-right {
    width: 100%;
    gap: 28px;
  }

  .stats-card {
    min-height: 208px;
    gap: 0;
    padding: 0;
    overflow: hidden;
    border: var(--border-w) solid var(--border-color);
    background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
    background-color: var(--surface);
  }

  .stat-item {
    position: relative;
    justify-content: center;
    padding: 28px 72px 28px 28px;
    border-right: var(--border-w) solid var(--border-color);
    border-bottom: var(--border-w) solid var(--border-color);
  }

  .stat-item:nth-child(2n) { border-right: 0; }
  .stat-item:nth-child(n+3) { border-bottom: 0; }
  .stat-value { order: -1; font-size: 30px; line-height: 1;
  color: var(--ink);
}

  .stat-icon {
    position: absolute;
    right: 26px;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;

    display: grid;
    place-items: center;

  color: var(--ink-soft);
}
  .stat-icon img { width: 22px; height: 22px; object-fit: contain; }





  .quick-access-card {
    padding: 20px;


  background: var(--surface);
  border-radius: var(--radius-md);
  border: var(--border-w) solid var(--border-color);
}

  .quick-access-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .quick-access-btn {
    min-height: 82px;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    text-align: center;
    font-size: 12px;

  background: var(--bg);
  border-radius: var(--radius-sm);
  border: var(--border-w) solid var(--border-color);
  color: var(--ink-soft);
}

  #mobile-view-home.active-view,
  #mobile-view-home {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) 420px;
    grid-template-areas:
      "recent artists"
      "queue queue";
    gap: 28px;
    width: 100%;
    margin-top: 20px;
  }

  #mobile-view-home > .hero-right,
  .mobile-hero-card,
  .mobile-quick-access,
  .mobile-queue-preview { display: none !important; }

  .recently-added-section {
    grid-area: recent;
    padding-top: 0;
  }

  .mobile-artists-preview {
    grid-area: artists;
    display: block !important;
  }

  .desktop-queue-section {
    grid-area: queue;
    display: block;
  }

  .recently-added-section .section-header-row,
  .mobile-artists-preview .section-header-row,
  .desktop-queue-section .section-header-row { padding: 0; }

  .section-link {
    border: 0;
    background: transparent;
    color: var(--accent);
    font-weight: 700;
    display: inline-flex;
    gap: 12px;
    align-items: center;
  }

  .recently-added-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
    overflow: visible;
    padding: 14px 0 0;
  }

  .thumbnail-card { min-width: 0; max-width: none; }
  .thumbnail-art { width: 100%; height: auto; aspect-ratio: 1.55 / 1; border-radius: 14px;
  border: var(--border-w) solid var(--border-color);
  background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
  background-color: var(--surface);
}
  .thumbnail-title { max-width: 100%; font-size: 15px; font-weight: 700;
  color: var(--ink);
}

  .mobile-artist-list {
    margin-top: 14px;
    border-radius: var(--radius-md);
    background: rgba(247, 245, 241, 0.72);
    border: 1px solid rgba(197, 194, 186, 0.34);
    box-shadow: var(--shadow-out-sm);
    overflow: hidden;
  }

  .mobile-artist-row {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    border: 0;
    border-bottom: 1px solid rgba(197, 194, 186, 0.34);
    background: transparent;
    text-align: left;
  }
  .mobile-artist-row:last-child { border-bottom: 0; }
  .artist-avatar { width: 46px; height: 46px; flex-basis: 46px; }
  .artist-row-copy { flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .artist-chevron { color: var(--text-secondary); font-size: 24px; }

  .desktop-queue-table {
    margin-top: 14px;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    background: rgba(247, 245, 241, 0.72);
    border: 1px solid rgba(197, 194, 186, 0.34);
    box-shadow: var(--shadow-out-sm);
  }

  .desktop-queue-head,
  .desktop-queue-row {
    display: grid;
    grid-template-columns: 42px minmax(220px, 1.6fr) minmax(150px, 1fr) minmax(180px, 1.3fr) 110px 120px 34px;
    align-items: center;
    gap: 18px;
  }

  .desktop-queue-head {
    padding: 8px 10px 14px;
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(197, 194, 186, 0.42);
  }

  .desktop-queue-row {
    min-height: 62px;
    padding: 10px;
    border-bottom: 1px solid rgba(197, 194, 186, 0.32);
    color: var(--text-secondary);
    font-size: 14px;
  }
  .desktop-queue-row:last-child { border-bottom: 0; }
  .desktop-queue-song { display: flex; align-items: center; gap: 14px; color: var(--text-primary); min-width: 0; }
  .desktop-queue-song strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .desktop-queue-art { width: 42px; height: 42px; flex: 0 0 42px; border-radius: 8px; }
  .desktop-queue-menu { border: 0; background: transparent; color: var(--text-secondary); font-size: 24px; }
}

/* PLAYBACK MODE (>= 900px) */
@media (min-width: 900px) {
  body.is-playback-mode .hero-section,
  body.is-playback-mode #quick-access-section,
  body.is-playback-mode .mobile-artists-preview,
  body.is-playback-mode .desktop-shuffle-all,
  body.is-playback-mode #sidebar .queue-divider,
  body.is-playback-mode #sidebar .queue-label,
  body.is-playback-mode #sidebar .playing-queue {
    display: none !important;
  }

  body.is-playback-mode .content-wrapper {
    display: grid !important;
    grid-template-columns: 400px minmax(0, 1fr) !important;
    grid-template-areas:
      "player queue"
      "recent recent" !important;
    column-gap: 28px;
    row-gap: 28px;
    align-items: stretch;
  }

  body.is-playback-mode .mainTop-container {
    display: contents !important;
  }

  body.is-playback-mode .sidebar-player.player {
    grid-area: player !important;
    position: sticky !important;
    display: flex !important;
    top: 98px !important; /* Offset for header + sep */
    bottom: auto !important;
    right: auto !important;
    width: 100% !important;
    height: max-content !important;
    z-index: 10 !important;
  }

  body.is-playback-mode .desktop-queue-section {
    grid-area: queue !important;
    display: block !important;
  }

  body.is-playback-mode .recently-added-section {
    grid-area: recent !important;
  }
}

@media (min-width: 1200px) {
  body.is-playback-mode .content-wrapper {
    grid-template-columns: 440px minmax(0, 1fr) !important;
  }
}

/* Make active queue row stand out a bit */
body.is-playback-mode .desktop-queue-row.active {
  background: var(--surface-raised);
  border-radius: var(--radius-sm);
}

body.is-playback-mode .desktop-queue-row.active .desktop-queue-index {
  color: var(--accent);
  font-weight: 700;
}

.desktop-shuffle-all:hover {
  background: var(--surface);
}
.desktop-shuffle-all:active {
  background: var(--ink);
  color: var(--bg);
}

.mobile-shuffle-all:hover {
  background: var(--surface);
}
.mobile-shuffle-all:active {
  background: var(--ink);
  color: var(--bg);
}

.quick-access-btn .icon-button {
  background: transparent !important;
  box-shadow: none !important;
  color: var(--ink-soft);
}

  .placeholder-flat {
    background-color: var(--surface);
    background-image: repeating-linear-gradient(45deg, transparent, transparent 6px, var(--border-hair) 6px, var(--border-hair) 7px);
    border: var(--border-w) solid var(--border-color);
  }

/* Mobile Now Playing premium flat-outline composition */
.nowplaying-more-button,
.queue-more-button {
  display: none;
}

.nowplaying-hero-card,
.playback-panel {
  display: contents;
}

@media (max-width: 768px) {
  #mobile-nowplaying-fullscreen {
    --mobile-player-margin: 20px;
    --mobile-card-padding: 12px;
    gap: 12px;
    padding-top: 12px;
    padding-bottom: 14px;
    background: var(--bg);
  }

  .nowplaying-drag-handle {
    display: none;
  }

  .nowplaying-hero-card,
  .playback-panel,
  .mobile-queue-peek {
    display: flex;
    flex-direction: column;
    width: calc(100% - (var(--mobile-player-margin) * 2));
    margin: 0 var(--mobile-player-margin);
    padding: var(--mobile-card-padding);
    border: var(--border-w) solid var(--border-color);
    border-radius: var(--radius-md);
    background: transparent;
    flex-shrink: 0;
  }

  .nowplaying-hero-card {
    gap: 14px;
    padding-top: 10px;
  }

  #mobile-nowplaying-fullscreen #waveform-canvas-mobile {
    width: 100%;
    height: clamp(170px, 29vh, 260px) !important;
    padding: 0;
    border: var(--border-w) solid var(--border-color);
    border-radius: 18px;
    background: var(--waveform-bg);
    overflow: hidden;
  }

  #mobile-nowplaying-fullscreen .player-info {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0;
    padding: 0;
  }

  #mobile-nowplaying-fullscreen .album-art-placeholder,
  #mobile-nowplaying-fullscreen .flex-spacer {
    display: none;
  }

  #mobile-nowplaying-fullscreen .track-meta {
    gap: 6px;
    min-width: 0;
  }

  #mobile-nowplaying-fullscreen .track-meta strong {
    color: var(--ink);
    font-size: clamp(16px, 6vw, 24px);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #mobile-nowplaying-fullscreen .track-meta span {
    color: var(--text-secondary);
    font-size: clamp(12px, 4.1vw, 16px);
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nowplaying-more-button,
  .queue-more-button {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: end;
    width: 48px;
    height: 48px;
    border: var(--border-w) solid var(--border-color);
    border-radius: 999px;
    background: transparent;
    box-shadow: none;
    padding: 0;
  }

  .nowplaying-more-button img,
  .queue-more-button img {
    display: block;
    object-fit: contain;
  }

  #mobile-nowplaying-fullscreen .progress-container {
    position: static;
    padding: 0;
  }

  .playback-panel {
    gap: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  #mobile-nowplaying-fullscreen .player-controls {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    width: 100%;
    gap: 10px;
    padding: 0;
    margin: 0;
  }

  #mobile-nowplaying-fullscreen .control-button,
  #mobile-nowplaying-fullscreen .icon-button {
    width: 36px;
    height: 36px;
    border-radius: 16px;
    box-shadow: none;
  }

  #mobile-nowplaying-fullscreen .control-button img,
  #mobile-nowplaying-fullscreen .icon-button img,
  #mobile-nowplaying-fullscreen .volume-btn img {
    width: 16px;
    height: 16px;
  }

  #mobile-nowplaying-fullscreen .play-button img {
    width: 28px;
    height: 28px;
  }

  #mobile-nowplaying-fullscreen .prev-button,
  #mobile-nowplaying-fullscreen .next-button {
    border-radius: 50%;
  }

  #mobile-nowplaying-fullscreen .play-button {
    width: 58px;
    height: 58px;
    box-shadow: none;
  }

  #mobile-nowplaying-fullscreen .volume-container {
    display: flex;
    width: 100%;
    gap: 14px;
    align-items: center;
    padding: 0;
    margin: 0;
  }

  #mobile-nowplaying-fullscreen .volume-btn {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border-radius: 16px;
  }

  #mobile-nowplaying-fullscreen #volume-slider {
    flex: 1 1 auto;
  }

  .mobile-queue-peek {
    gap: 14px;
    padding-top: 16px;
  }

  .mobile-queue-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .queue-peek-label {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--text-secondary);
  }

  .mobile-queue-divider {
    height: var(--border-hair-w);
    background: var(--border-color);
    opacity: 0.45;
  }

  .mobile-queue-row {
    display: grid;
    grid-template-columns: 64px 1fr 40px;
    align-items: center;
    gap: 16px;
    padding: 2px 0;
    border: 0;
  }

  .mobile-queue-art {
    width: 56px;
    height: 56px;
    border: var(--border-w) solid var(--border-color);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-queue-art span {
    width: 22px;
    height: 28px;
    border-left: var(--border-w) solid var(--border-color);
    border-bottom: var(--border-w) solid var(--border-color);
    transform: skewY(-8deg);
  }

  .mobile-queue-copy {
    min-width: 0;
  }

  .mobile-queue-title {
    font-size: 17px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 5px;
  }

  .mobile-queue-artist {
    font-size: 16px;
    color: var(--text-secondary);
  }

  .mobile-queue-reorder {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }

  .mobile-queue-reorder span {
    display: block;
    width: 32px;
    height: var(--border-w);
    background: var(--border-color);
  }
}
